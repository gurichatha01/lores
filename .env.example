LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Razorpay (Test Mode keys work — no live account/KYC needed for testing).
# Get test keys from the Razorpay Dashboard → Settings → API Keys (Test Mode).
# RAZORPAY_KEY_ID is sent to the browser to open Checkout; the SECRET is
# server-only and must never be exposed client-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Accepting non-INR/foreign cards requires International Payments enabled on the
# Razorpay account (extra KYC/approval). Leave false to run INR-only for
# everyone until it's approved; set true to switch on the USD path.
RAZORPAY_INTERNATIONAL_ENABLED=false

# Local testing only: force a country code (e.g. IN or US) when there's no geo
# header. Ignored in production where platform geo headers are present.
DEV_COUNTRY_OVERRIDE=

# ── Supabase (Brief 2: 10-report pack accounts + credit ledger) ──────────────
# Create a free project at https://supabase.com, then Project Settings → API.
# URL + anon key are client-safe. The SERVICE ROLE key is server-only — it must
# NEVER appear in the browser bundle. All credit writes use the service role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The anon URL/key are also exposed to the client for Supabase Auth (login/signup).
# Next only ships env vars prefixed NEXT_PUBLIC_* to the browser — mirror them here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev/comp path (grant credits without paying). Unreachable in production:
# the endpoint 404s unless NODE_ENV!=='production' AND this secret matches.
DEV_COMP_SECRET=

# Keep-alive ping auth (optional): protects the cron endpoint that stops the
# free-tier project from pausing during the build window.
KEEP_ALIVE_SECRET=
