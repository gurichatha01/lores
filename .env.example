LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Razorpay (Test Mode keys work — no live account/KYC needed for testing).
# Get test keys from the Razorpay Dashboard → Settings → API Keys (Test Mode).
# RAZORPAY_KEY_ID is sent to the browser to open Checkout; the SECRET is
# server-only and must never be exposed client-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Accepting non-INR/foreign cards requires International Payments enabled on the
# Razorpay account (extra KYC/approval). Leave false to run INR-only for
# everyone until it's approved; set true to switch on the USD path.
RAZORPAY_INTERNATIONAL_ENABLED=false

# Local testing only: force a country code (e.g. IN or US) when there's no geo
# header. Ignored in production where platform geo headers are present.
DEV_COUNTRY_OVERRIDE=
